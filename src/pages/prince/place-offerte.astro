---
import PrinceLayout from '../../layouts/PrinceLayout.astro';
---

<PrinceLayout
  title="Invitation | PRINCE à Genève"
  description="Utilisez votre code invitation pour PRINCE à Genève le 10 décembre 2026."
>
  <section class="py-24 px-6 md:px-12 min-h-[80vh] flex items-center justify-center relative overflow-hidden">
    <div class="absolute inset-0 glow-gold opacity-50 -z-10"></div>
    <div class="max-w-xl mx-auto text-center space-y-8 z-10">
      <span class="inline-block px-4 py-1.5 rounded-full bg-[#E8C76A]/10 border border-[#E8C76A]/30 text-[#E8C76A] text-xs font-bold uppercase tracking-widest">
        Invitation
      </span>
      <h1 class="text-3xl md:text-5xl font-serif tracking-tight text-[#F2EFEA]">
        Votre invitation vous attend.
      </h1>
      <p class="text-base md:text-lg text-[#F2EFEA]/85 font-light leading-relaxed">
        Utilisez votre code pour réserver votre place gratuite unique pour le 10 décembre 2026 à Genève.
      </p>
      <a id="invitation-link" href="/prince/invitation" class="inline-flex items-center gap-2 px-10 py-5 bg-[#E8C76A] text-[#0A0A14] font-bold text-sm tracking-widest uppercase rounded-full hover:bg-white hover:scale-105 transition-all duration-300 shadow-xl shadow-[#E8C76A]/20">
        Accéder à mon invitation
        <iconify-icon icon="solar:arrow-right-linear" stroke-width="1.5" class="text-sm"></iconify-icon>
      </a>
    </div>
  </section>
</PrinceLayout>

<script is:inline>
  const invitationUrl = '/prince/invitation' + window.location.search;
  document.getElementById('invitation-link').href = invitationUrl;
  window.location.replace(invitationUrl);
</script>
