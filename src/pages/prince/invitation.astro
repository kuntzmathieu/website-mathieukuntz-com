---
import PrinceLayout from '../../layouts/PrinceLayout.astro';
---

<PrinceLayout
  title="Votre invitation | PRINCE à Genève, 10 décembre 2026"
  description="Enregistrez votre place gratuite unique pour PRINCE à la Salle Centrale de la Madeleine à Genève le 10 décembre 2026."
>
  <section class="py-16 px-6 md:px-12 min-h-[80vh] relative overflow-hidden">
    <div class="absolute inset-0 glow-gold opacity-50 -z-10"></div>
    <div class="max-w-2xl mx-auto w-full space-y-10 z-10 relative">
      <div class="text-center space-y-4">
        <a href="/prince" class="inline-block text-2xl md:text-3xl font-serif tracking-widest text-[#E8C76A] uppercase">
          PRINCE
        </a>
        <span class="block text-sm uppercase tracking-widest text-[#E8C76A] font-bold">
          Invitation pour Genève
        </span>
        <h1 class="text-3xl md:text-5xl font-serif tracking-tight text-[#F2EFEA]">
          Votre place gratuite vous attend.
        </h1>
        <p class="text-base md:text-lg text-[#F2EFEA]/85 font-light leading-relaxed max-w-xl mx-auto">
          Votre code donne droit à une place gratuite unique pour le jeudi 10 décembre 2026 à 20h00, à la Salle Centrale de la Madeleine à Genève. Ouverture des portes à 19h30.
        </p>
        <p class="text-sm text-white/50 font-light">
          Une place par code. Aucun paiement n'est demandé.
        </p>
      </div>

      <div id="invitation-identity" class="hidden rounded-xl bg-[#E8C76A]/10 border border-[#E8C76A]/30 p-4 text-sm text-[#F2EFEA]/85 font-light leading-relaxed">
        Cette invitation est <strong class="text-[#E8C76A]">nominative</strong> : elle est réservée à
        <strong id="identity-name" class="text-[#F2EFEA]"></strong>.
        Le prénom, le nom et l'année de naissance sont liés au code et ne peuvent pas être modifiés.
        Seul l'email peut être changé.
      </div>

      <form id="invitation-form" class="rounded-2xl bg-white/[0.03] border border-[#E8C76A]/30 p-6 md:p-8 space-y-6 shadow-2xl shadow-[#E8C76A]/5">
        <div class="space-y-2">
          <label for="code" class="text-xs uppercase tracking-widest text-white/50 block">Code unique <span class="text-[#E8C76A]">*</span></label>
          <input id="code" name="code" type="text" required autocomplete="off" autocapitalize="characters" placeholder="Votre code invitation" class="w-full px-4 py-3 bg-white/[0.02] border border-white/10 rounded-lg text-[#F2EFEA] placeholder-white/30 font-light outline-none focus:border-[#E8C76A]/40 transition-colors uppercase tracking-wider" />
          <p id="code-status" class="hidden text-sm font-light"></p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-2">
            <label for="prenom" class="text-xs uppercase tracking-widest text-white/50 block">Prénom <span class="text-[#E8C76A]">*</span></label>
            <input id="prenom" name="prenom" type="text" required autocomplete="given-name" class="w-full px-4 py-3 bg-white/[0.02] border border-white/10 rounded-lg text-[#F2EFEA] font-light outline-none focus:border-[#E8C76A]/40 transition-colors" />
          </div>
          <div class="space-y-2">
            <label for="nom" class="text-xs uppercase tracking-widest text-white/50 block">Nom <span class="text-[#E8C76A]">*</span></label>
            <input id="nom" name="nom" type="text" required autocomplete="family-name" class="w-full px-4 py-3 bg-white/[0.02] border border-white/10 rounded-lg text-[#F2EFEA] font-light outline-none focus:border-[#E8C76A]/40 transition-colors" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-2">
            <label for="annee_naissance" class="text-xs uppercase tracking-widest text-white/50 block">Année de naissance <span class="text-[#E8C76A]">*</span></label>
            <input id="annee_naissance" name="annee_naissance" type="text" required inputmode="numeric" maxlength="4" pattern="[0-9]{4}" placeholder="1990" class="w-full px-4 py-3 bg-white/[0.02] border border-white/10 rounded-lg text-[#F2EFEA] placeholder-white/30 font-light outline-none focus:border-[#E8C76A]/40 transition-colors" />
          </div>
          <div class="space-y-2">
            <label for="code_postal" class="text-xs uppercase tracking-widest text-white/50 block">Code postal <span class="text-white/30">(facultatif)</span></label>
            <input id="code_postal" name="code_postal" type="text" inputmode="numeric" maxlength="10" autocomplete="postal-code" class="w-full px-4 py-3 bg-white/[0.02] border border-white/10 rounded-lg text-[#F2EFEA] font-light outline-none focus:border-[#E8C76A]/40 transition-colors" />
          </div>
        </div>

        <div class="space-y-2">
          <label for="email" class="text-xs uppercase tracking-widest text-white/50 block">Email <span class="text-[#E8C76A]">*</span></label>
          <input id="email" name="email" type="email" required autocomplete="email" placeholder="vous@email.com" class="w-full px-4 py-3 bg-white/[0.02] border border-white/10 rounded-lg text-[#F2EFEA] placeholder-white/30 font-light outline-none focus:border-[#E8C76A]/40 transition-colors" />
        </div>

        <p id="invitation-error" class="hidden text-sm text-red-400 font-light" role="alert"></p>

        <button type="submit" id="invitation-submit" class="w-full px-10 py-5 bg-[#E8C76A] text-[#0A0A14] font-bold text-sm tracking-widest uppercase rounded-full hover:bg-white hover:scale-[1.02] transition-all duration-300 shadow-xl shadow-[#E8C76A]/20 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100">
          Utiliser mon invitation
        </button>
      </form>

      <div id="invitation-used" class="hidden rounded-2xl bg-white/[0.03] border border-white/10 p-8 text-center space-y-4" role="alert">
        <iconify-icon icon="solar:info-circle-bold" class="text-5xl text-[#E8C76A]"></iconify-icon>
        <h2 class="text-2xl font-serif text-[#F2EFEA]">Ce code a déjà été utilisé.</h2>
        <p class="text-sm text-[#F2EFEA]/70 font-light leading-relaxed">
          Une invitation donne droit à une seule place, nominative et non transférable.
          Si tu penses qu'il s'agit d'une erreur, écris à
          <a href="mailto:mk@mathieukuntz.org" class="text-[#E8C76A] hover:underline">mk@mathieukuntz.org</a>.
        </p>
      </div>

      <div id="invitation-success" class="hidden text-center space-y-6 py-12" role="status">
        <iconify-icon icon="solar:check-circle-bold" class="text-6xl text-[#E8C76A]"></iconify-icon>
        <h2 class="text-3xl md:text-4xl font-serif text-[#F2EFEA]">Votre place est enregistrée.</h2>
        <p class="text-base md:text-lg text-[#F2EFEA]/85 font-light leading-relaxed max-w-md mx-auto">
          Merci ! Votre invitation pour le 10 décembre 2026 est confirmée. Redirection en cours...
        </p>
      </div>

      <p class="text-center text-sm text-white/40 font-light">
        Une question ? Écrivez à <a href="mailto:mk@mathieukuntz.org" class="text-[#E8C76A] hover:underline">mk@mathieukuntz.org</a>.
      </p>
    </div>
  </section>
</PrinceLayout>

<script is:inline>
  const invitationForm = document.getElementById('invitation-form');
  const invitationCode = document.getElementById('code');
  const invitationError = document.getElementById('invitation-error');
  const invitationSubmit = document.getElementById('invitation-submit');
  const codeStatus = document.getElementById('code-status');
  const identityBanner = document.getElementById('invitation-identity');
  const identityName = document.getElementById('identity-name');
  const invitationUsed = document.getElementById('invitation-used');
  const lockedFields = ['prenom', 'nom', 'annee_naissance'].map((id) => document.getElementById(id));
  invitationSubmit.disabled = true;

  function setStatus(text, tone) {
    codeStatus.textContent = text;
    codeStatus.className = 'text-sm font-light ' + (
      tone === 'error' ? 'text-red-400' : tone === 'success' ? 'text-[#E8C76A]' : 'text-white/50'
    );
    codeStatus.classList.toggle('hidden', !text);
  }

  function setLocked(locked) {
    for (const field of lockedFields) {
      field.readOnly = locked;
      field.classList.toggle('opacity-60', locked);
      field.classList.toggle('cursor-not-allowed', locked);
      if (locked) field.setAttribute('aria-readonly', 'true');
      else field.removeAttribute('aria-readonly');
    }
    invitationCode.readOnly = locked;
    invitationCode.classList.toggle('opacity-60', locked);
    invitationCode.classList.toggle('cursor-not-allowed', locked);
  }

  function clearIdentity() {
    setLocked(false);
    identityBanner.classList.add('hidden');
    identityName.textContent = '';
    for (const field of lockedFields) field.value = '';
    document.getElementById('email').value = '';
  }

  async function loadInvitation() {
    const code = invitationCode.value.trim().toUpperCase();
    if (!code) return;
    setStatus('Vérification du code...', 'muted');
    try {
      const res = await fetch('/api/invitation-info?code=' + encodeURIComponent(code));
      const data = await res.json().catch(() => ({}));

      if (!res.ok) {
        clearIdentity();
        invitationForm.classList.remove('hidden');
        invitationUsed.classList.add('hidden');
        invitationSubmit.disabled = true;
        setStatus(data.error || 'Code invalide.', 'error');
        return;
      }

      if (data.utilise) {
        invitationForm.classList.add('hidden');
        invitationUsed.classList.remove('hidden');
        invitationSubmit.disabled = true;
        setStatus('', 'muted');
        return;
      }

      if (!data.valide) {
        clearIdentity();
        invitationSubmit.disabled = true;
        setStatus('Code invalide.', 'error');
        return;
      }

      document.getElementById('prenom').value = data.prenom || '';
      document.getElementById('nom').value = data.nom || '';
      document.getElementById('annee_naissance').value = data.annee_naissance || '';
      document.getElementById('email').value = data.email || '';
      identityName.textContent = `${data.prenom || ''} ${data.nom || ''}`.trim();
      identityBanner.classList.remove('hidden');
      invitationUsed.classList.add('hidden');
      invitationForm.classList.remove('hidden');
      setLocked(true);
      invitationSubmit.disabled = false;
      setStatus('Code valide. Vérifie ton email, puis valide ta place.', 'success');
    } catch (err) {
      setStatus('Erreur de vérification. Réessaie.', 'error');
    }
  }

  const codeFromUrl = new URLSearchParams(window.location.search).get('code');
  if (codeFromUrl) {
    invitationCode.value = codeFromUrl;
    loadInvitation();
  }

  invitationCode.addEventListener('blur', () => {
    if (!invitationCode.readOnly) loadInvitation();
  });

  invitationForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    invitationError.classList.add('hidden');
    invitationSubmit.disabled = true;
    invitationSubmit.textContent = 'Enregistrement...';

    const payload = {
      code: invitationCode.value.trim().toUpperCase(),
      prenom: document.getElementById('prenom').value.trim(),
      nom: document.getElementById('nom').value.trim(),
      annee_naissance: document.getElementById('annee_naissance').value.trim(),
      email: document.getElementById('email').value.trim(),
      code_postal: document.getElementById('code_postal').value.trim(),
    };

    try {
      const res = await fetch('/api/submit-invitation', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error(data.error || 'Ce code ne peut pas être validé. Vérifiez-le puis réessayez.');
      }

      invitationForm.classList.add('hidden');
      invitationUsed.classList.add('hidden');
      document.getElementById('invitation-success').classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
      setTimeout(() => {
        window.location.href = '/prince/merci';
      }, 1600);
    } catch (err) {
      invitationError.textContent = err.message || 'Une erreur est survenue. Réessayez dans un instant.';
      invitationError.classList.remove('hidden');
      invitationSubmit.disabled = false;
      invitationSubmit.textContent = 'Utiliser mon invitation';
    }
  });
</script>
